
{% extends 'base.html.twig' %}

{% block main %}
    <h1>Liste des utilisateurs</h1>
    <ul>
        {% for user in users %}
            <li>{{ user.username }} ({{ user.email }})</li>
        {% endfor %}
    </ul>

    <h1>Films Populaires</h1>
    <div style="display: flex; flex-wrap: wrap; gap: 20px;">
        {% for movie in movies %}
            <div style="border: 1px solid #ccc; padding: 10px; width: 200px;">
                {# Construction de l'URL de l'image #}
                <img src="https://image.tmdb.org/t/p/w500{{ movie.poster_path }}" alt="{{ movie.title }}" style="width: 100%;">

                <h3>{{ movie.title }}</h3>
                <p>Note: {{ movie.vote_average }}/10</p>
                <p><small>{{ movie.release_date }}</small></p>

                {# Exemple si vous voulez ajouter à votre Watchlist plus tard #}
                <a href="#">Ajouter à ma liste</a>
            </div>
        {% else %}
            <p>Aucun film trouvé.</p>
        {% endfor %}
    </div>
{% endblock main %}
